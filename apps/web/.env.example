# Configuración de Firebase Auth — Proyecto > Configuración del proyecto > Tus apps > SDK setup and configuration
# Copia este archivo a .env.local y llena los valores. Sin ellos, la pantalla de login
# muestra un aviso de "configuración pendiente" en vez de fallar en silencio.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Antes de probar el login, crea en la consola de Firebase (Authentication > Sign-in method >
# Email/Password) al menos la cuenta admin (el correo debe coincidir con el usuario_id=1 de
# db.usuarios en lib/api.mock.ts — hoy dgarcia@planjuarez.org). Las cuentas de operador/consulta
# (antes ana@demo.test / beto@demo.test) son opcionales — solo se necesitan si quieres probar los
# flujos de rol limitado (RBAC, pantalla 403, vista de solo lectura).

# Muestra controles exclusivos de demo/validación (p. ej. "Simular e.firma vencida").
# Poner en "false" o quitar la variable para una build de producción.
VITE_DEMO_CONTROLS=true
