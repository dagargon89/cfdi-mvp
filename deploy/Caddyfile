# Proxy de entrada de Hub CFDI en producción (runbook Sprint 5, ítem A.1).
#
# Caddy obtiene y renueva el certificado TLS por sí solo (Let's Encrypt) en cuanto el dominio
# apunta a este servidor y los puertos 80 y 443 están abiertos. El 80 hace falta aunque todo se
# sirva por HTTPS: ahí responde el desafío de Let's Encrypt y desde ahí redirige a HTTPS.
#
# Un solo dominio sirve las dos cosas: la interfaz (archivos estáticos) y la API bajo /v1. Así el
# navegador no hace peticiones de origen cruzado y los enlaces firmados de descarga
# (`PUBLIC_BASE_URL/v1/descargas-archivo/...`) caen en el mismo sitio.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# La API. Nada más que /v1 y /health llega al backend: /docs y /openapi.json además están
	# cerrados en el propio FastAPI cuando ENVIRONMENT=production.
	@api path /v1/* /health
	handle @api {
		reverse_proxy api:8000
	}

	# La interfaz: rutas de la SPA (/e/11/comprobantes, etc.) caen en index.html.
	handle {
		root * /srv/web
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
