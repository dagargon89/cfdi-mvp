# PLANTILLA — configuración fiscal POR EMPRESA.
#
# ======================================================================================
# CÓMO SE USA
# ======================================================================================
#   1. Copia este archivo SIN el sufijo `.ejemplo` y con el nombre de la organización:
#
#        cp config/fiscal/empresa.yaml.ejemplo config/fiscal/empresa-acme.yaml
#
#   2. Edítalo con los datos reales de esa organización.
#   3. Cárgalo indicando A QUÉ EMPRESA pertenece:
#
#        python -m app.scripts.cargar_configuracion_fiscal config/fiscal/empresa-acme.yaml --empresa-id 1
#
# El `--empresa-id` es obligatorio y no tiene valor por omisión: las tres secciones de este
# archivo cuelgan de una empresa, y el mismo texto de departamento mapea a centros de costo
# distintos en organizaciones distintas. El cargador falla si falta o si la empresa no existe.
#
# TODOS LOS VALORES DE ABAJO SON FICTICIOS y están puestos solo para mostrar la forma del
# archivo. No los cargues tal cual: no describen a ninguna organización real.
#
# ======================================================================================
# LO QUE NO VA EN ESTE ARCHIVO
# ======================================================================================
# La UMA, los salarios mínimos y las marcas de percepción son iguales para todas las
# organizaciones: viven en `param_fiscal.yaml` y `catalogo_percepcion.yaml`, y se cargan una
# sola vez sin `--empresa-id`. Aquí va solo lo que cambia de una empresa a otra.
#
# A diferencia de esos dos, lo de este archivo NO lleva puerta de confirmación: es
# configuración operativa de la organización, no una cifra de la ley. Se aplica en cuanto se
# carga. Revísalo antes de cargarlo, no después.

# --------------------------------------------------------------------------------------
# Política laboral de la organización.
#
# Los tres campos nacen en NULL a propósito y NO tienen valor por omisión (ver el docstring
# de `app/models/configuracion_fiscal.py`). En la PRIMERA carga, dejar uno fuera hace que el
# informe que lo necesita reporte "no evalué esto y te digo por qué", que es información; un
# valor adivinado sería una mentira silenciosa.
#
# AL RECARGAR es distinto, y conviene tenerlo claro: **el campo que este archivo no menciona
# no se toca**. Si alguien capturó los días de aguinaldo por la pantalla o por
# `administrar_configuracion configurar-empresa` y aquí no aparecen, se conservan. Antes se
# borraban en silencio y sin bitácora —el cargador no escribe ninguna—, y sin días de
# aguinaldo B-08 deja de generarse: un informe se apagaba y no había rastro de quién lo
# apagó. El resumen de la carga te dice qué campos conservó.
#
# Para BORRAR uno hay que escribirlo con `null` explícito (`dias_aguinaldo:` a secas, o
# `dias_aguinaldo: null`). Es la diferencia entre "esto no lo administra este archivo" y
# "quítalo": ausente conserva, `null` borra. Y el rastro de ese borrado es este archivo en
# git, que es el único que tiene el cargador.
# --------------------------------------------------------------------------------------
configuracion_empresa:
  # GENERAL o ZLFN (Zona Libre de la Frontera Norte).
  # NO tiene default, y es el campo más importante del archivo: el salario mínimo de la ZLFN
  # es ~40% mayor que el general, así que suponer "GENERAL" en una empresa fronteriza
  # (Ciudad Juárez lo es) daría por buenos salarios que están por debajo del mínimo. Sin este
  # dato, B-10 se abstiene de evaluar esa validación en vez de darla por pasada.
  - zona_salarial: ZLFN

    # Días de aguinaldo que paga esta organización. El art. 87 de la LFT pone un PISO de 15
    # días, no un valor único: muchas organizaciones pagan más y el sistema no puede
    # adivinar cuál es el caso.
    dias_aguinaldo: 15

    # Factor de prima vacacional. El art. 80 de la LFT pone un piso de 0.25 ("no menor de
    # veinticinco por ciento"), igual que arriba: es un mínimo, no un valor único.
    # ENTRECOMILLADO: sin comillas el YAML lo lee como float y pierde precisión.
    factor_prima_vacacional: '0.25'

# --------------------------------------------------------------------------------------
# Departamento (texto libre tal como viene en el CFDI de nómina) -> centro de costo.
#
# El texto de la izquierda tiene que coincidir EXACTAMENTE con lo que trae el atributo
# `Departamento` del nodo receptor de la nómina, espacios y acentos incluidos: es texto libre
# que captura cada patrón, no una clave de catálogo. Un departamento que no esté aquí sale en
# el informe sin centro de costo, no se inventa uno.
# --------------------------------------------------------------------------------------
map_departamento:
  - departamento_texto: 'DEPARTAMENTO DE EJEMPLO A'
    centro_costo: 'CC-000'
  - departamento_texto: 'DEPARTAMENTO DE EJEMPLO B'
    centro_costo: 'CC-001'

# --------------------------------------------------------------------------------------
# Concepto de nómina de la organización -> categoría de provisión contable (B-08).
#
#   naturaleza  'P' percepción · 'D' deducción · 'O' otro pago  (una sola posición)
#   tipo        clave del catálogo del SAT (tres posiciones, ENTRECOMILLADA)
#   clave       la clave INTERNA que usa el patrón para ese concepto, hasta 15 caracteres
#   categoria   AGUINALDO | VACACIONES | PRIMA_VACACIONAL
#
# POR QUÉ ESTA SECCIÓN EXISTE Y NO BASTA CON EL TIPO DEL SAT: las VACACIONES no tienen un
# `tipo_percepcion` propio en el catálogo `c_TipoPercepcion` — se pagan dentro del 001
# (Sueldos, Salarios Rayas y Jornales). La única forma de identificarlas para el pasivo
# laboral es la clave interna del patrón, y esa es distinta en cada organización. Sin esta
# sección, B-08 no puede provisionar vacaciones.
# --------------------------------------------------------------------------------------
map_concepto_provision:
  - naturaleza: 'P'
    tipo: '002'          # Gratificación Anual (Aguinaldo)
    clave: 'EJEMPLO-01'  # clave interna ficticia del patrón
    categoria: AGUINALDO
  - naturaleza: 'P'
    tipo: '001'          # Sueldos: aquí es donde suelen venir las vacaciones pagadas
    clave: 'EJEMPLO-02'
    categoria: VACACIONES
  - naturaleza: 'P'
    tipo: '021'          # Prima vacacional
    clave: 'EJEMPLO-03'
    categoria: PRIMA_VACACIONAL
