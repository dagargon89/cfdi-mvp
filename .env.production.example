# Variables de producción de Hub CFDI. NO se versiona el archivo real (.env.production).
#
# La forma recomendada de crearlo es `sudo deploy/generar_secretos.sh`: copia esta plantilla,
# genera los valores aleatorios y crea la KEK. Después solo completas lo marcado como [TÚ].

# --- Dominio y certificado -------------------------------------------------------------------
# [TÚ] Dominio que ya apunta (registro A) a la IP del VPS. Sin https:// ni barra final.
DOMAIN=hubcfdi.ejemplo.org
# [TÚ] Correo para Let's Encrypt (avisos de vencimiento del certificado).
ACME_EMAIL=admin@ejemplo.org

# --- Base de datos (generadas) ---------------------------------------------------------------
# Root solo lo usan los contenedores `mysql` y `migrate`; la aplicación usa `hub_cfdi_app`.
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=

# --- Secretos de la aplicación (generados) ---------------------------------------------------
# Firma de enlaces temporales de descarga. Rotarlo invalida los enlaces en curso (duran minutos).
SIGNING_SECRET=
# Alta del primer administrador. Bórralo de aquí en cuanto exista el admin y reinicia `api`.
BOOTSTRAP_ADMIN_TOKEN=

# --- Firebase ---------------------------------------------------------------------------------
# [TÚ] El mismo proyecto de Firebase de siempre. La cuenta de servicio va como archivo en
# secrets/firebase-service-account.json (no aquí).
FIREBASE_PROJECT_ID=
# [TÚ] Configuración web de Firebase (Consola > Configuración del proyecto > Tus apps). Es
# pública por diseño de Firebase, pero se hornea en el JavaScript al construir la imagen `web`:
# si cambia, hay que reconstruir.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# --- Opcionales -------------------------------------------------------------------------------
# Token gratuito de la API SIE de Banxico para el tipo de cambio FIX. Vacío = sin sincronizar
# (la pantalla de Configuración fiscal lo avisa).
BANXICO_TOKEN=
