# Copia a .env y llena los valores. Ninguno de estos se versiona (ver .gitignore).

ENVIRONMENT=development

# MySQL — el docker-compose local expone 3308 en el host para no chocar con otros proyectos
DATABASE_URL=mysql+asyncmy://hub_cfdi:hub_cfdi@localhost:3308/hub_cfdi

# Redis (Celery broker/result backend)
REDIS_URL=redis://localhost:6380/0

# Bóveda — KEK de desarrollo generada por app/scripts/generar_kek_dev.py (32 bytes, permisos 600).
# NUNCA usar este mecanismo en producción (ver Hub_CFDI_docs/04-seguridad/04_plan_de_seguridad.md §3.5).
KEK_PATH=./secrets/kek.dev.bin

# Firebase Admin SDK — Proyecto > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=cfdi-app

# Orígenes permitidos para CORS (la SPA de apps/web)
CORS_ORIGINS=http://localhost:5173
