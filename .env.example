# Copia a .env y llena los valores. Ninguno de estos se versiona (ver .gitignore).

ENVIRONMENT=development

# MySQL — el docker-compose local expone 3308 en el host para no chocar con otros proyectos
DATABASE_URL=mysql+asyncmy://hub_cfdi:hub_cfdi@localhost:3308/hub_cfdi

# Redis (Celery broker/result backend)
REDIS_URL=redis://localhost:6380/0

# Bóveda — KEK de desarrollo generada por app/scripts/generar_kek_dev.py (32 bytes, permisos 600).
# NUNCA usar este mecanismo en producción (ver Hub_CFDI_docs/04-seguridad/04_plan_de_seguridad.md §3.5).
KEK_PATH=./secrets/kek.dev.bin

# Firebase Admin SDK — Proyecto > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=cfdi-app

# Orígenes permitidos para CORS (la SPA de apps/web)
CORS_ORIGINS=http://localhost:5173

# Raíz donde el worker escribe los paquetes descargados del SAT (RF-DESC-06)
STORAGE_ROOT=./storage

# Firma de enlaces temporales de descarga (doc 05 §6) — genera el tuyo, p. ej. `openssl rand -hex 32`.
# No es material de e.firma, no usa la KEK.
SIGNING_SECRET=
# Host público de la API — los enlaces firmados los abre el navegador directo.
PUBLIC_BASE_URL=http://localhost:8000

# Nota: el correo saliente de notificaciones (RF-NOT-01) ya NO se configura aquí — se
# captura desde la UI en Configuración → Correo (cualquier admin puede usar el correo y la
# contraseña de aplicación que prefiera) y se guarda cifrado en la BD, no en variables de
# entorno.

# Alta del primer administrador (una sola vez tras desplegar con BD vacía). Deja vacío para
# deshabilitar. Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOOTSTRAP_ADMIN_TOKEN=

# API SIE de Banxico — sincroniza el tipo de cambio FIX (serie SF43718) para `param_fiscal`.
# Gratuito: se pide en https://www.banxico.org.mx/SieAPIRest/service/v1/token
# Vacío = sincronización deshabilitada. NO se apaga en silencio: la alarma de vigencia fiscal
# devuelve una alerta `SINCRONIZACION_FALLIDA` diciendo que falta el token, y el tipo de cambio
# se sigue pudiendo capturar a mano desde Configuración → Fiscal.
# La UMA y el salario mínimo NO se sincronizan: no hay API (ver el docstring de
# app/services/sincronizacion_fiscal.py). Los vigila la alarma de calendario, que no usa red.
BANXICO_TOKEN=
